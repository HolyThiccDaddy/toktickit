// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ActionState {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMIN
}

model RequesterUser {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  department String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// User is the authenticated Lab 3 identity. RequesterUser remains in the
// schema during the incremental migration so Lab 2 routes and records can be
// read while Issue #37 moves requester operations to session-derived identity.
model User {
  id                  Int              @id @default(autoincrement())
  email               String           @unique
  displayName         String
  department          String?
  role                UserRole
  passwordHash        String
  mustChangePassword  Boolean          @default(true)
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sessions            AuthSession[]
  requesterTickets    Ticket[]         @relation("TicketRequester")
  ownedTickets        Ticket[]         @relation("TicketOwner")
  uploadedAttachments Attachment[]     @relation("AttachmentUploader")
  publicComments      PublicComment[]  @relation("PublicCommentAuthor")
  internalNotes       InternalNote[]   @relation("InternalNoteAuthor")
  assignedActions     ActionTaken[]    @relation("ActionTakenAssignee")
  performedActions    ActionTaken[]    @relation("ActionTakenPerformer")
  completedActions    ActionTaken[]    @relation("ActionTakenCompleter")
  cancelledActions    ActionTaken[]    @relation("ActionTakenCanceller")
  resolvedActions     ActionTaken[]    @relation("ActionTakenFollowUpResolver")
  actionRevisions     ActionRevision[] @relation("ActionRevisionEditor")

  @@index([role])
  @@index([active, role])
  @@index([active, mustChangePassword])
}

model AuthSession {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  userId        Int
  expiresAt     DateTime
  revokedAt     DateTime?
  csrfTokenHash String?
  csrfExpiresAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  tickets     Ticket[]
}

model RelatedSystem {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  tickets     Ticket[]
}

model Ticket {
  id                             Int          @id @default(autoincrement())
  ticketNumber                   String       @unique
  summary                        String
  description                    String
  requestedPriority              Priority
  itPriority                     Priority     @default(LOW)
  currentStatus                  TicketStatus @default(NEW)
  requesterId                    Int
  ownerId                        Int?
  categoryId                     Int
  relatedSystemId                Int
  requesterResolutionIndicatedAt DateTime?
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt

  requester      User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner          User?           @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category       Category        @relation(fields: [categoryId], references: [id])
  relatedSystem  RelatedSystem   @relation(fields: [relatedSystemId], references: [id])
  attachments    Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]
  actions        ActionTaken[]

  @@index([requesterId, createdAt])
  @@index([requesterId, updatedAt])
  @@index([ownerId, currentStatus])
  @@index([currentStatus, itPriority, updatedAt])
  @@index([categoryId])
  @@index([relatedSystemId])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("PublicCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storageKey       String    @unique
  mimeType         String
  fileSize         Int
  isDeleted        Boolean   @default(false)
  deletionReason   String?
  deletedAt        DateTime?
  uploaderId       Int?
  createdAt        DateTime  @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader User?  @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([ticketId, isDeleted])
}

model TicketCounter {
  year         Int @id
  lastSequence Int @default(0)
}

model ActionTaken {
  id                     Int         @id @default(autoincrement())
  ticketId               Int
  actionDateTime         DateTime    @db.Timestamptz(6)
  description            String      @db.VarChar(2000)
  result                 String      @db.VarChar(2000)
  state                  ActionState @default(OPEN)
  assigneeId             Int?
  performedById          Int
  completedAt            DateTime?   @db.Timestamptz(6)
  completedById          Int?
  cancelledAt            DateTime?   @db.Timestamptz(6)
  cancelledById          Int?
  followUpRequired       Boolean     @default(false)
  followUpNote           String?     @db.VarChar(2000)
  followUpResolvedAt     DateTime?   @db.Timestamptz(6)
  followUpResolvedById   Int?
  attachmentNotes        String?     @db.VarChar(2000)
  idempotencyKey         String      @db.Uuid
  idempotencyFingerprint String      @db.Char(64)
  idempotencyResponse    Json?
  createdAt              DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime    @updatedAt @db.Timestamptz(6)
  version                Int         @default(1)

  ticket             Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee           User?            @relation("ActionTakenAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  performedBy        User             @relation("ActionTakenPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  completedBy        User?            @relation("ActionTakenCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy        User?            @relation("ActionTakenCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  followUpResolvedBy User?            @relation("ActionTakenFollowUpResolver", fields: [followUpResolvedById], references: [id], onDelete: Restrict)
  revisions          ActionRevision[]

  @@unique([ticketId, idempotencyKey])
  @@index([ticketId, actionDateTime, id])
  @@index([performedById, actionDateTime])
  @@index([assigneeId, state])
  @@index([state, completedAt])
}

model ActionRevision {
  id          Int      @id @default(autoincrement())
  actionId    Int
  version     Int
  before      Json
  changedById Int
  changedAt   DateTime @default(now()) @db.Timestamptz(6)

  action    ActionTaken @relation(fields: [actionId], references: [id], onDelete: Cascade)
  changedBy User        @relation("ActionRevisionEditor", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([actionId, version])
}
